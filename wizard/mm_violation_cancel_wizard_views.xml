<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mm_violation_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">mm.violation.cancel.wizard.form</field>
        <field name="model">mm.violation.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Violation">
                <field name="violation_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this violation being cancelled?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Violation" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
