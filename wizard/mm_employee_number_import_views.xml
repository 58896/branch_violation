<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mm_employee_number_import_view_form" model="ir.ui.view">
        <field name="name">mm.employee.number.import.form</field>
        <field name="model">mm.employee.number.import</field>
        <field name="arch" type="xml">
            <form string="Import Employee Numbers">
                <field name="state" invisible="1"/>
                <field name="report_filename" invisible="1"/>
                <!-- Step 1 -->
                <div invisible="state != 'upload'">
                    <p class="text-muted">
                        Upload the Jisr export (.xlsx). It needs an employee number column
                        (e.g. “الرقم الوظيفي”) and an employee name column (e.g. “اسم الموظف”).
                        Job title and branch columns are optional.
                    </p>
                    <group>
                        <field name="file" filename="filename" required="state == 'upload'"/>
                        <field name="filename" invisible="1"/>
                        <field name="sheet_name" placeholder="Optional - leave empty to detect"/>
                        <field name="update_job_branch"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </div>
                <!-- Step 2 -->
                <div invisible="state != 'review'">
                    <group>
                        <group>
                            <field name="used_sheet" string="Sheet"/>
                            <field name="update_job_branch" readonly="1"/>
                        </group>
                        <group>
                            <field name="matched_count" string="Ready to Import"/>
                            <field name="attention_count" string="Need Attention"
                                   decoration-danger="attention_count &gt; 0"/>
                            <field name="skipped_count" string="Skipped"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Pick the right employee for rows that are Not Found or Ambiguous,
                        or tick Skip. Rows with an issue are not imported.
                    </p>
                </div>
                <field name="line_ids" invisible="state != 'review'" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-danger="issue"
                          decoration-warning="match_status in ('ambiguous', 'unmatched') and not issue"
                          decoration-muted="match_status == 'skipped'">
                        <field name="company_id" column_invisible="True"/>
                        <field name="row_number"/>
                        <field name="file_employee_number"/>
                        <field name="file_employee_name"/>
                        <field name="file_job" optional="hide"/>
                        <field name="file_branch" optional="hide"/>
                        <field name="match_status" widget="badge"/>
                        <field name="employee_id" readonly="skip" options="{'no_create': True}"/>
                        <field name="employee_active" string="Active" optional="hide"/>
                        <field name="candidate_ids" widget="many2many_tags" optional="show"/>
                        <field name="branch_id" optional="hide" readonly="skip" options="{'no_create': True}"/>
                        <field name="issue"/>
                        <field name="skip"/>
                    </list>
                </field>
                <!-- Step 3 -->
                <div invisible="state != 'done'">
                    <field name="result_message" nolabel="1"/>
                </div>
                <group invisible="state == 'upload' or not report_file">
                    <field name="report_file" filename="report_filename" string="Rows Needing Attention (xlsx)"/>
                </group>
                <footer>
                    <button name="action_read_file" type="object" string="Read File" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"
                            invisible="state != 'review'"
                            confirm="Write the employee numbers of the rows that are ready?"/>
                    <button name="action_refresh_report" type="object" string="Refresh Report"
                            invisible="state != 'review'"/>
                    <button name="action_back" type="object" string="Back"
                            invisible="state != 'review'"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mm_employee_number_import_action" model="ir.actions.act_window">
        <field name="name">Import Employee Numbers</field>
        <field name="res_model">mm.employee.number.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
