<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mm_performance_scorecard_view_form" model="ir.ui.view">
        <field name="name">mm.performance.scorecard.form</field>
        <field name="model">mm.performance.scorecard</field>
        <field name="arch" type="xml">
            <form string="Performance Scorecard" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Update"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            icon="fa-file-pdf-o"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period" widget="radio" options="{'horizontal': true}"/>
                            <label for="date_from" string="Dates"/>
                            <div class="o_row">
                                <field name="date_from" readonly="period != 'custom'" force_save="1"/>
                                <span>→</span>
                                <field name="date_to" readonly="period != 'custom'" force_save="1"/>
                            </div>
                        </group>
                        <group>
                            <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="language" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="summary_html" nolabel="1" readonly="1"/>
                    <div class="text-muted small mb-2">
                        Branch score = <field name="weight_sales" class="d-inline"/>% sales target achieved
                        (capped at 100%) + <field name="weight_mistakes" class="d-inline"/>% mistakes score
                        (100 - violation points per employee); a branch without a sales target is scored on
                        mistakes only. Employee score = 100 - violation points. Only approved violations count.
                        Arrows compare with the previous period (<field name="previous_label" class="d-inline"/>).
                    </div>
                    <notebook>
                        <page string="Branch Ranking" name="branches">
                            <field name="branch_line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0"
                                      decoration-success="rank &lt;= 3" decoration-danger="is_bottom">
                                    <field name="is_bottom" column_invisible="1"/>
                                    <field name="trend" column_invisible="1"/>
                                    <field name="rank" string="#"/>
                                    <field name="medal"/>
                                    <field name="branch_id" options="{'no_open': True}"/>
                                    <field name="score" widget="progressbar"/>
                                    <field name="sales_label"/>
                                    <field name="sales_target" optional="hide"/>
                                    <field name="sales_achieved" optional="hide"/>
                                    <field name="sales_score" optional="hide"/>
                                    <field name="mistakes_score" optional="show"/>
                                    <field name="violations" sum="Total"/>
                                    <field name="points" sum="Total"/>
                                    <field name="headcount"/>
                                    <field name="points_per_employee"/>
                                    <field name="complaints" sum="Total"/>
                                    <field name="complaints_resolved" optional="hide"/>
                                    <field name="complaints_open" optional="hide"/>
                                    <field name="complaints_late" optional="hide"/>
                                    <field name="rank_change" decoration-success="trend == 'up'"
                                           decoration-danger="trend == 'down'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employee Ranking" name="employees">
                            <field name="employee_line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0" limit="100"
                                      decoration-warning="is_employee_of_month" decoration-bf="is_employee_of_month"
                                      decoration-danger="is_bottom">
                                    <field name="is_bottom" column_invisible="1"/>
                                    <field name="is_employee_of_month" column_invisible="1"/>
                                    <field name="trend" column_invisible="1"/>
                                    <field name="rank" string="#"/>
                                    <field name="medal"/>
                                    <field name="employee_id" options="{'no_open': True}"/>
                                    <field name="branch_id" options="{'no_open': True}"/>
                                    <field name="job_id" optional="hide" options="{'no_open': True}"/>
                                    <field name="score" widget="progressbar"/>
                                    <field name="violations" sum="Total"/>
                                    <field name="points" sum="Total"/>
                                    <field name="complaints"/>
                                    <field name="spotless" column_invisible="1"/>
                                    <field name="clean_label" string="Days Without Mistake"/>
                                    <field name="rank_change" decoration-success="trend == 'up'"
                                           decoration-danger="trend == 'down'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer Service" name="service">
                            <div class="text-muted small mb-2">
                                Customer Service calls customers back for every branch, so this is measured per
                                person, not per branch. A complaint counts for the person assigned to it, else for
                                who contacted the customer.
                            </div>
                            <field name="service_line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0" decoration-danger="overdue &gt; 0">
                                    <field name="rank" string="#"/>
                                    <field name="name_label"/>
                                    <field name="complaints" sum="Total"/>
                                    <field name="on_time_pct" widget="progressbar"/>
                                    <field name="contacted" optional="hide"/>
                                    <field name="on_time" optional="show"/>
                                    <field name="late" optional="show"/>
                                    <field name="overdue" sum="Total"/>
                                    <field name="open_count" sum="Total"/>
                                    <field name="resolved" optional="show"/>
                                    <field name="unresolved" optional="show"/>
                                    <field name="resolved_pct"/>
                                    <field name="avg_hours"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mm_performance_scorecard_action" model="ir.actions.server">
        <field name="name">Performance Scorecard</field>
        <field name="model_id" ref="model_mm_performance_scorecard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
        <field name="groups_id" eval="[(4, ref('mm_branch_violation.group_violation_manager'))]"/>
    </record>
</odoo>
