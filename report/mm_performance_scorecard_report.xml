<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mm_performance_scorecard" model="ir.actions.report">
        <field name="name">Performance Scorecard (PDF)</field>
        <field name="model">mm.performance.scorecard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mm_branch_violation.report_mm_performance_scorecard</field>
        <field name="report_file">mm_branch_violation.report_mm_performance_scorecard</field>
        <field name="print_report_name">object._mm_file_name()</field>
        <field name="paperformat_id" ref="pos_sales_target_commission.pstc_paperformat_landscape"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_mm_performance_scorecard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="meta" t-value="doc._mm_report_meta()"/>
                <t t-set="h" t-value="doc._mm_highlights()"/>
                <!-- "article" is required: without it wkhtmltopdf gets no
                     charset and Arabic turns into mojibake -->
                <div class="article pstc-report" t-att-dir="meta['rtl'] and 'rtl' or 'ltr'"
                     t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
                    <t t-call="pos_sales_target_commission.pstc_report_styles"/>
                    <t t-call="mm_branch_violation.mm_violation_report_styles"/>
                    <style>
                        .mmp-top td { font-weight: 700; }
                        .mmp-gold { background: #FFF6DA; }
                        .mmp-bottom td { color: #C0392B; }
                        .mmp-up { color: #27AE60; font-weight: 700; }
                        .mmp-down { color: #E74C3C; font-weight: 700; }
                        .mmp-name { font-size: 14px; font-weight: 700; color: #1B2A4A; margin-top: 2px; }
                    </style>

                    <table class="pstc-header">
                        <tr>
                            <td style="width:50%;">
                                <img class="pstc-logo" t-if="meta['company'].logo"
                                     t-att-src="image_data_uri(meta['company'].logo)"/>
                                <div class="pstc-company-name" t-esc="meta['company'].name"/>
                            </td>
                            <td style="width:50%; text-align:right;">
                                <p class="pstc-title">Performance Scorecard</p>
                                <p class="pstc-subtitle"><span class="pstc-ltr" t-esc="meta['period_label']"/></p>
                            </td>
                        </tr>
                    </table>
                    <div class="pstc-meta-row">
                        <span><b>Branches:</b> <t t-esc="meta['branches_label']"/></span>
                        <span><b>Generated By:</b> <t t-esc="meta['generated_by']"/></span>
                        <span><b>Generated On:</b> <span class="pstc-ltr" t-esc="meta['generated_on']"/></span>
                    </div>

                    <table class="pstc-kpi-cards">
                        <tr>
                            <td class="pstc-kpi-card" style="border-top-color: #27AE60;">
                                <div class="pstc-kpi-label">Best Branch</div>
                                <div class="mmp-name" t-esc="h['best_branch'].branch_id.display_name or '—'"/>
                                <div class="mmv-kpi-sub" t-if="h['best_branch']" t-esc="h['best_branch']._mm_summary()"/>
                                <div class="mmv-kpi-sub" t-if="h['tied_branches'] &gt; 1" style="color:#E07C1F;">
                                    Tied with <t t-esc="h['tied_branches'] - 1"/> others
                                </div>
                            </td>
                            <td class="pstc-kpi-card" style="border-top-color: #C9950C;">
                                <div class="pstc-kpi-label">Employee of the Period</div>
                                <div class="mmp-name" t-esc="h['employee_of_month'].employee_id.sudo().name or '—'"/>
                                <div class="mmv-kpi-sub" t-if="h['employee_of_month']"
                                     t-esc="h['employee_of_month']._mm_clean_label(with_branch=True)"/>
                                <div class="mmv-kpi-sub" t-if="h['tied_first'] &gt; 1" style="color:#E07C1F;">
                                    Tied with <t t-esc="h['tied_first'] - 1"/> others
                                </div>
                            </td>
                            <td class="pstc-kpi-card" style="border-top-color: #E74C3C;">
                                <div class="pstc-kpi-label">Branch Needing Attention</div>
                                <div class="mmp-name" t-esc="h['worst_branch'].branch_id.display_name or '—'"/>
                                <div class="mmv-kpi-sub" t-if="h['worst_branch']" t-esc="h['worst_branch']._mm_summary()"/>
                            </td>
                            <td class="pstc-kpi-card" style="border-top-color: #2F80ED;">
                                <div class="pstc-kpi-label">Employees Without Mistakes</div>
                                <div class="pstc-kpi-value"><span class="pstc-ltr"><t t-esc="h['clean']"/> / <t t-esc="h['staff']"/></span></div>
                                <div class="mmv-kpi-sub">
                                    <t t-esc="h['violations']"/> violations ·
                                    <t t-esc="h['complaints']"/> customer complaints
                                </div>
                            </td>
                        </tr>
                    </table>
                    <div class="mmv-note">
                        Branch score = <t t-esc="doc.weight_sales"/>% sales target achieved (capped at 100%)
                        + <t t-esc="doc.weight_mistakes"/>% mistakes score (100 - violation points per employee);
                        no sales target = mistakes only. Employee score = 100 - violation points. Only approved
                        violations count. Movement compares with <span class="pstc-ltr" t-esc="doc.previous_label"/>.
                    </div>

                    <div class="mmv-section">Branch Ranking</div>
                    <table class="pstc-table">
                        <thead>
                            <tr>
                                <th class="mmv-center">#</th>
                                <th style="width:26%;">Branch</th>
                                <th class="mmv-center">Score</th>
                                <th class="mmv-center">Target Achieved</th>
                                <th class="mmv-center">Mistakes Score</th>
                                <th class="mmv-center">Violations</th>
                                <th class="mmv-center">Points</th>
                                <th class="mmv-center">Employees</th>
                                <th class="mmv-center">Points / Employee</th>
                                <th class="mmv-center">Complaints</th>
                                <th class="mmv-center">vs Previous</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.branch_line_ids.sorted('rank')" t-as="line"
                                t-att-class="(line.rank == 1 and 'mmp-top mmp-gold') or (line.rank &lt;= 3 and 'mmp-top') or (line.is_bottom and 'mmp-bottom') or ''">
                                <td class="mmv-center" t-esc="line.rank"/>
                                <td t-esc="line.branch_id.display_name"/>
                                <td class="mmv-center" t-esc="round(line.score, 1)"/>
                                <td class="mmv-center"><span class="pstc-ltr" t-esc="line.sales_label"/></td>
                                <td class="mmv-center" t-esc="round(line.mistakes_score, 1)"/>
                                <td class="mmv-center" t-esc="line.violations"/>
                                <td class="mmv-center" t-esc="round(line.points, 2)"/>
                                <td class="mmv-center" t-esc="line.headcount"/>
                                <td class="mmv-center" t-esc="round(line.points_per_employee, 2)"/>
                                <td class="mmv-center" t-esc="line.complaints"/>
                                <td class="mmv-center"><span t-attf-class="pstc-ltr mmp-#{line.trend or ''}" t-esc="line.rank_change or '—'"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mmv-section">Customer Service</div>
                    <table class="pstc-table">
                        <thead>
                            <tr>
                                <th class="mmv-center">#</th>
                                <th style="width:24%;">Customer Service</th>
                                <th class="mmv-center">Complaints</th>
                                <th class="mmv-center">On Time %</th>
                                <th class="mmv-center">Contacted Late</th>
                                <th class="mmv-center">Overdue Now</th>
                                <th class="mmv-center">Still Open</th>
                                <th class="mmv-center">Resolved %</th>
                                <th class="mmv-center">Avg Hours to Contact</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.service_line_ids.sorted('rank')" t-as="line"
                                t-att-class="line.overdue and 'mmp-bottom' or ''">
                                <td class="mmv-center" t-esc="line.rank"/>
                                <td t-esc="line.name_label"/>
                                <td class="mmv-center" t-esc="line.complaints"/>
                                <td class="mmv-center"><span class="pstc-ltr" t-esc="str(round(line.on_time_pct)) + '%'"/></td>
                                <td class="mmv-center" t-esc="line.late"/>
                                <td class="mmv-center" t-esc="line.overdue"/>
                                <td class="mmv-center" t-esc="line.open_count"/>
                                <td class="mmv-center"><span class="pstc-ltr" t-esc="str(round(line.resolved_pct)) + '%'"/></td>
                                <td class="mmv-center" t-esc="round(line.avg_hours, 1)"/>
                            </tr>
                            <tr t-if="not doc.service_line_ids"><td colspan="9" class="mmv-center">No customer complaints in this period.</td></tr>
                        </tbody>
                    </table>

                    <div class="mmv-section mmv-page-break">Employee Ranking - Top 15</div>
                    <t t-set="emp_lines" t-value="doc.employee_line_ids.sorted('rank')"/>
                    <t t-set="emp_cols" t-value="[('top', emp_lines[:15]), ('bottom', doc._mm_most_mistakes(15))]"/>
                    <t t-foreach="emp_cols" t-as="col">
                        <div t-if="col[0] == 'bottom'" class="mmv-section">Most Mistakes - Top 15</div>
                        <table class="pstc-table">
                            <thead>
                                <tr>
                                    <th class="mmv-center">#</th>
                                    <th style="width:24%;">Employee</th>
                                    <th style="width:20%;">Branch</th>
                                    <th class="mmv-center">Score</th>
                                    <th class="mmv-center">Violations</th>
                                    <th class="mmv-center">Points</th>
                                    <th class="mmv-center">Complaints</th>
                                    <th class="mmv-center">Days Without Mistake</th>
                                    <th class="mmv-center">vs Previous</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="col[1]" t-as="line"
                                    t-att-class="(line.is_employee_of_month and 'mmp-top mmp-gold') or (col[0] == 'bottom' and 'mmp-bottom') or ''">
                                    <td class="mmv-center" t-esc="line.rank"/>
                                    <td t-esc="line.employee_id.sudo().name"/>
                                    <td t-esc="line.branch_id.display_name"/>
                                    <td class="mmv-center" t-esc="round(line.score, 1)"/>
                                    <td class="mmv-center" t-esc="line.violations"/>
                                    <td class="mmv-center" t-esc="round(line.points, 2)"/>
                                    <td class="mmv-center" t-esc="line.complaints"/>
                                    <td class="mmv-center" t-esc="line.clean_label"/>
                                    <td class="mmv-center"><span t-attf-class="pstc-ltr mmp-#{line.trend or ''}" t-esc="line.rank_change or '—'"/></td>
                                </tr>
                                <tr t-if="not col[1]"><td colspan="9" class="mmv-center">No employee had a mistake in this period.</td></tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
