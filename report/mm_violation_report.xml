<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mm_violation" model="ir.actions.report">
        <field name="name">Branch Violations Report (PDF)</field>
        <field name="model">mm.violation.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mm_branch_violation.report_mm_violation</field>
        <field name="report_file">mm_branch_violation.report_mm_violation</field>
        <field name="print_report_name">object._mm_file_name('pdf')</field>
        <field name="paperformat_id" ref="pos_sales_target_commission.pstc_paperformat_landscape"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- extra styles on top of pos_sales_target_commission.pstc_report_styles -->
    <template id="mm_violation_report_styles">
        <style>
            .mmv-section { margin: 16px 0 6px 0; font-size: 13px; font-weight: 700; color: #1B2A4A;
                           padding: 0 8px; page-break-after: avoid; }
            .pstc-report[dir="ltr"] .mmv-section { border-left: 4px solid #C9950C; }
            .pstc-report[dir="rtl"] .mmv-section { border-right: 4px solid #C9950C; }
            .mmv-note { font-size: 9px; color: #6B7280; margin-bottom: 4px; }
            .mmv-cols { width: 100%; border-collapse: collapse; }
            .mmv-cols > tbody > tr > td { vertical-align: top; width: 50%; border: none; padding: 0; }
            .pstc-report[dir="ltr"] .mmv-cols > tbody > tr > td:first-child { padding-right: 10px; }
            .pstc-report[dir="rtl"] .mmv-cols > tbody > tr > td:first-child { padding-left: 10px; }
            .mmv-center { text-align: center; }
            .mmv-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin: 0 4px; }
            .mmv-kpi-sub { font-size: 9px; color: #6B7280; margin-top: 2px; }
            .mmv-delta { font-size: 10px; font-weight: 700; margin-top: 2px; }
            .mmv-insights { background: #FFFBEA; border: 1px solid #F1D48A; border-radius: 6px;
                            padding: 6px 12px; margin-bottom: 6px; }
            .mmv-insight { font-size: 11px; color: #1F2937; padding: 2px 0; }
            .mmv-empty { text-align: center; color: #9CA3AF; padding: 40px 0; font-size: 13px; }
            .mmv-page-break { page-break-before: always; }
            .mmv-legend span { display: inline-block; margin: 0 10px 0 0; font-size: 9px; white-space: nowrap; }
        </style>
    </template>

    <template id="report_mm_violation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._mm_collect()"/>
                <t t-set="meta" t-value="data['meta']"/>
                <t t-set="kpis" t-value="data['kpis']"/>
                <t t-set="c" t-value="data['colors']"/>
                <!-- "article" is required: without it wkhtmltopdf gets no
                     charset and Arabic turns into mojibake -->
                <div class="article pstc-report" t-att-dir="meta['rtl'] and 'rtl' or 'ltr'"
                     t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
                    <t t-call="pos_sales_target_commission.pstc_report_styles"/>
                    <t t-call="mm_branch_violation.mm_violation_report_styles"/>

                    <!-- header -->
                    <table class="pstc-header">
                        <tr>
                            <td style="width:50%;">
                                <img class="pstc-logo" t-if="meta['company'].logo"
                                     t-att-src="image_data_uri(meta['company'].logo)"/>
                                <div class="pstc-company-name" t-esc="meta['company'].name"/>
                            </td>
                            <td style="width:50%; text-align:right;">
                                <p class="pstc-title" t-esc="meta['title']"/>
                                <p class="pstc-subtitle"><span class="pstc-ltr" t-esc="meta['period_label']"/></p>
                            </td>
                        </tr>
                    </table>
                    <div class="pstc-meta-row">
                        <span><b>Filters:</b> <t t-esc="meta['filters_label']"/></span>
                        <span><b>Generated By:</b> <t t-esc="meta['generated_by']"/></span>
                        <span><b>Generated On:</b> <span class="pstc-ltr" t-esc="meta['generated_on']"/></span>
                    </div>

                    <t t-if="not kpis['violations']">
                        <p class="mmv-empty">No violations match the selected filters.</p>
                    </t>
                    <t t-else="">
                        <!-- headline figures -->
                        <table class="pstc-kpi-cards">
                            <tr>
                                <td class="pstc-kpi-card">
                                    <div class="pstc-kpi-label">Violations</div>
                                    <div class="pstc-kpi-value" t-esc="kpis['violations']"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['violations']['color']};" t-esc="data['deltas']['violations']['text']"/>
                                </td>
                                <td class="pstc-kpi-card" t-attf-style="border-top-color: #{c['gold']};">
                                    <div class="pstc-kpi-label">Total Points</div>
                                    <div class="pstc-kpi-value" t-esc="'{:,.2f}'.format(kpis['points']).rstrip('0').rstrip('.')"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['points']['color']};" t-esc="data['deltas']['points']['text']"/>
                                </td>
                                <td class="pstc-kpi-card" t-attf-style="border-top-color: #{c['blue']};">
                                    <div class="pstc-kpi-label">Employees Affected</div>
                                    <div class="pstc-kpi-value" t-esc="kpis['employees']"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['employees']['color']};" t-esc="data['deltas']['employees']['text']"/>
                                </td>
                                <td class="pstc-kpi-card" t-attf-style="border-top-color: #{c['green']};">
                                    <div class="pstc-kpi-label">Branches Affected</div>
                                    <div class="pstc-kpi-value" t-esc="kpis['branches']"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['branches']['color']};" t-esc="data['deltas']['branches']['text']"/>
                                </td>
                                <td class="pstc-kpi-card" t-attf-style="border-top-color: #{c['orange']};">
                                    <div class="pstc-kpi-label">Avg Points / Employee</div>
                                    <div class="pstc-kpi-value" t-esc="'{:,.1f}'.format(kpis['avg_points'])"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['avg_points']['color']};" t-esc="data['deltas']['avg_points']['text']"/>
                                </td>
                                <td class="pstc-kpi-card" t-attf-style="border-top-color: #{c['red']};">
                                    <div class="pstc-kpi-label">Employees at 30%+</div>
                                    <div class="pstc-kpi-value" t-attf-style="color: #{kpis['critical'] and c['red'] or c['navy']};"
                                         t-esc="kpis['critical']"/>
                                    <div class="mmv-delta" t-attf-style="color: #{data['deltas']['critical']['color']};" t-esc="data['deltas']['critical']['text']"/>
                                </td>
                            </tr>
                        </table>
                        <div class="mmv-note">▲ / ▼ = change vs the previous period (<span class="pstc-ltr" t-esc="data['previous_label']"/>). ▲ more violations = worse.</div>

                        <!-- key insights -->
                        <div class="mmv-section">Key Insights</div>
                        <div class="mmv-insights">
                            <!-- the Arabic subset of IBM Plex has no "." glyph: a full stop right
                                 after an Arabic word prints as a box, and bullets need none -->
                            <div t-foreach="data['insights']" t-as="line" class="mmv-insight">• <t t-esc="meta['rtl'] and line.rstrip('.') or line"/></div>
                        </div>

                        <!-- by branch -->
                        <div class="mmv-section">Violations by Branch</div>
                        <table class="pstc-table">
                            <thead>
                                <tr>
                                    <th style="width:24%;">Branch</th>
                                    <th class="mmv-center">Violations</th>
                                    <th class="mmv-center">Total Points</th>
                                    <th class="mmv-center">Employees</th>
                                    <th class="mmv-center">Avg Points / Employee</th>
                                    <th style="width:20%;">Share of Points</th>
                                    <th style="width:26%;">Most Common Violation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['branches']" t-as="row">
                                    <td t-esc="row['name']"/>
                                    <td class="mmv-center" t-esc="row['violations']"/>
                                    <td class="mmv-center"><b t-esc="'{:,.2f}'.format(row['points'])"/></td>
                                    <td class="mmv-center" t-esc="row['employees']"/>
                                    <td class="mmv-center" t-esc="'{:,.1f}'.format(row['avg'])"/>
                                    <td>
                                        <div class="pstc-bar-track">
                                            <div class="pstc-bar-fill" t-attf-style="width: #{row['bar']}%; background: #{c['navy']};"/>
                                        </div>
                                        <span class="pstc-bar-label pstc-ltr" t-esc="str(row['share']) + '%'"/>
                                    </td>
                                    <td t-esc="row['top_type']"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Total</td>
                                    <td class="mmv-center" t-esc="kpis['violations']"/>
                                    <td class="mmv-center" t-esc="'{:,.2f}'.format(kpis['points'])"/>
                                    <td class="mmv-center" t-esc="kpis['employees']"/>
                                    <td class="mmv-center" t-esc="'{:,.1f}'.format(kpis['avg_points'])"/>
                                    <td/>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- top violations: full width, may continue on the next page -->
                        <div class="mmv-section">Top Violations</div>
                        <table class="pstc-table">
                            <thead>
                                <tr>
                                    <th>Violation</th>
                                    <th class="mmv-center">Count</th>
                                    <th class="mmv-center">Points</th>
                                    <th style="width:26%;">Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['types']" t-as="row">
                                    <td><span class="mmv-dot" t-attf-style="background: #{row['color']};"/><t t-esc="row['name']"/></td>
                                    <td class="mmv-center" t-esc="row['violations']"/>
                                    <td class="mmv-center" t-esc="'{:,.2f}'.format(row['points'])"/>
                                    <td>
                                        <div class="pstc-bar-track">
                                            <div class="pstc-bar-fill" t-attf-style="width: #{row['bar']}%; background: #{row['color']};"/>
                                        </div>
                                        <span class="pstc-bar-label pstc-ltr" t-esc="str(row['share']) + '%'"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- sources + note types side by side -->
                        <table class="mmv-cols">
                            <tr>
                                <td>
                                    <div class="mmv-section">By Source</div>
                                    <table class="pstc-table">
                                        <thead>
                                            <tr>
                                                <th>Source</th>
                                                <th class="mmv-center">Count</th>
                                                <th style="width:36%;">Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="data['sources']" t-as="row">
                                                <td t-esc="row['name']"/>
                                                <td class="mmv-center" t-esc="row['violations']"/>
                                                <td>
                                                    <div class="pstc-bar-track">
                                                        <div class="pstc-bar-fill" t-attf-style="width: #{row['bar']}%; background: #{c['blue']};"/>
                                                    </div>
                                                    <span class="pstc-bar-label pstc-ltr" t-esc="str(row['share']) + '%'"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                                <td>
                                    <div class="mmv-section">By Note Type</div>
                                    <table class="pstc-table">
                                        <thead>
                                            <tr>
                                                <th>Note Type</th>
                                                <th class="mmv-center">Count</th>
                                                <th style="width:36%;">Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="data['note_types']" t-as="row">
                                                <td t-esc="row['name']"/>
                                                <td class="mmv-center" t-esc="row['violations']"/>
                                                <td>
                                                    <div class="pstc-bar-track">
                                                        <div class="pstc-bar-fill" t-attf-style="width: #{row['bar']}%; background: #{c['green']};"/>
                                                    </div>
                                                    <span class="pstc-bar-label pstc-ltr" t-esc="str(row['share']) + '%'"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- monthly trend -->
                        <t t-if="data['show_trend']">
                            <div class="mmv-section">Monthly Trend</div>
                            <table class="pstc-table">
                                <thead>
                                    <tr>
                                        <th style="width:14%;">Month</th>
                                        <th class="mmv-center" style="width:12%;">Violations</th>
                                        <th class="mmv-center" style="width:12%;">Total Points</th>
                                        <th class="mmv-center" style="width:12%;">Employees</th>
                                        <th>Trend</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['trend']" t-as="row">
                                        <td><span class="pstc-ltr" t-esc="row['month']"/></td>
                                        <td class="mmv-center" t-esc="row['violations']"/>
                                        <td class="mmv-center" t-esc="'{:,.2f}'.format(row['points'])"/>
                                        <td class="mmv-center" t-esc="row['employees']"/>
                                        <td>
                                            <div class="pstc-bar-track" style="height:10px;">
                                                <div class="pstc-bar-fill" t-attf-style="width: #{row['bar']}%; background: #{c['gold']}; height:10px;"/>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- employee ranking -->
                        <div class="mmv-section">Employee Ranking</div>
                        <div class="mmv-note mmv-legend">
                            <span><span class="pstc-badge pstc-badge-red">Critical</span> deduction 30% or more</span>
                            <span><span class="pstc-badge pstc-badge-orange">Warning</span> 15% to 29%</span>
                            <span><span class="pstc-badge pstc-badge-green">Low</span> below 15%</span>
                            <span>Deduction % = total points, capped at 100%.</span>
                        </div>
                        <table class="pstc-table">
                            <thead>
                                <tr>
                                    <th class="mmv-center" style="width:5%;">#</th>
                                    <th class="mmv-center" style="width:10%;">Employee Number</th>
                                    <th style="width:22%;">Employee</th>
                                    <th style="width:11%;">Job Position</th>
                                    <th style="width:20%;">Branch</th>
                                    <th class="mmv-center">Violations</th>
                                    <th class="mmv-center">Total Points</th>
                                    <th class="mmv-center">Deduction %</th>
                                    <th class="mmv-center">Risk Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['employees']" t-as="row">
                                    <td class="mmv-center">
                                        <span t-if="row['rank'] &lt;= 3" t-attf-class="pstc-rank-medal pstc-rank-#{row['rank']}" t-esc="row['rank']"/>
                                        <t t-else="" t-esc="row['rank']"/>
                                    </td>
                                    <td class="mmv-center" t-esc="row['number']"/>
                                    <td t-esc="row['name']"/>
                                    <td t-esc="row['job']"/>
                                    <td t-esc="row['branch']"/>
                                    <td class="mmv-center" t-esc="row['violations']"/>
                                    <td class="mmv-center" t-esc="'{:,.2f}'.format(row['points'])"/>
                                    <td class="mmv-center"><b t-attf-style="color: #{row['color']};" t-esc="'{:,.1f}%'.format(row['deduction'])"/></td>
                                    <td class="mmv-center">
                                        <span t-attf-class="pstc-badge #{row['badge']}"
                                              t-esc="row['level_label']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- details -->
                        <t t-if="data['details']">
                            <div class="mmv-section">Violation List</div>
                            <table class="pstc-table">
                                <thead>
                                    <tr>
                                        <th style="width:10%;">Reference</th>
                                        <th style="width:8%;">Date</th>
                                        <th style="width:15%;">Branch</th>
                                        <th style="width:16%;">Employee</th>
                                        <th style="width:25%;">Violation</th>
                                        <th style="width:11%;">Source</th>
                                        <th class="mmv-center" style="width:6%;">Points</th>
                                        <th class="mmv-center" style="width:9%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['details']" t-as="row">
                                        <td><span class="pstc-ltr" t-esc="row['ref']"/></td>
                                        <td><span class="pstc-ltr" t-esc="row['date']"/></td>
                                        <td t-esc="row['branch']"/>
                                        <td>
                                            <t t-esc="row['employee']"/>
                                            <div t-if="row['number']" class="mmv-note" style="margin:0;">#<t t-esc="row['number']"/></div>
                                        </td>
                                        <td>
                                            <t t-esc="row['type']"/>
                                            <div t-if="row['carried']" class="mmv-note" style="margin:0;">Carried forward</div>
                                        </td>
                                        <td t-esc="row['source']"/>
                                        <td class="mmv-center" t-esc="'{:,.2f}'.format(row['points'])"/>
                                        <td class="mmv-center">
                                            <span t-attf-class="pstc-badge #{row['badge']}"
                                                  t-esc="row['state']"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6">Total</td>
                                        <td class="mmv-center" t-esc="'{:,.2f}'.format(kpis['points'])"/>
                                        <td/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>

                    <div class="pstc-footer">
                        <span t-esc="meta['company'].name"/>
                        <span><t t-esc="meta['title']"/> · <span class="pstc-ltr" t-esc="meta['generated_on']"/></span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
